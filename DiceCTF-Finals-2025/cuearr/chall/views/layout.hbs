<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>cuearr</title>
    <style>
        * {
            font-family: sans-serif;
        }

        body {
            padding: 3rem 5rem;
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            margin: 0;
        }

        hr {
            margin: 1rem 0;
        }

        input:not([type="submit"]),
        textarea {
            width: 50vw;
            border-width: 1px;
            padding: 0.5rem 1rem;
            margin: 0.5rem 0rem;
            font-size: 0.875rem;
            line-height: 1.5;
        }

        input,
        textarea {
            display: block;
        }

        input[type="submit"],
        button {
            padding: 0.5rem 1rem;
            margin: 0.5em 0rem;
            background-color: #3459e6;
            color: #fff;
            border: 1px solid #3459e6;
            transition: background-color 0.15s ease-in-out, border-color 0.15s ease-in-out;
            cursor: pointer;
        }

        input[type="submit"]:hover,
        button:hover {
            background-color: #2c4cc4;
            border-color: #2c4cc4;
        }

        input[type="submit"]:active,
        button:active {
            background-color: #2a47b8;
            border-color: #2743ad;
        }

        input[type="color"] {
            width: 3rem;
            height: 2rem;
            padding: 0;
            border: none;
            cursor: pointer;
        }

        .qr-center-image {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 10;
            border-radius: 8px;
            background: white;
            padding: 4px;
        }
    </style>
</head>

<body>
    {{{body}}}
</body>

</html>